  "stops": [
    {
      "id": "arrive",
      "title": "Torrey Landing",
      "short": "Torrey Landing",
      "at": [840, 84],
      "icon": "ossabaw-art/icons--landing.9fc331b30c.webp",
      "intro": "Every visit starts here at the north end, after about 1 hour on the water. Unpack the naturalist's kit on the dock: each object stands for something you will meet on the island."
    },
    {
      "id": "history",
      "title": "The Main Road",
      "short": "Main Road",
      "at": [735, 360],
      "icon": "ossabaw-art/icons--road.2e1a6dc830.webp",
      "intro": "People have walked this road for 5,000 years. Tap the road, the oaks and the stone marker."
    },
    {
      "id": "tabby",
      "title": "The tabby cabins",
      "short": "North End",
      "at": [712, 176],
      "icon": "ossabaw-art/icons--tabby.802fe1a995.webp",
      "intro": "Three tabby cabins survive at the North End, built between 1820 to 1840 by enslaved carpenters and masons."
    },
    {
      "id": "house",
      "title": "The Torrey West House",
      "short": "Torrey West House",
      "at": [880, 248],
      "icon": "ossabaw-art/icons--house.05eeb1d2be.webp",
      "intro": "The pink house the Torreys finished in 1926, restored by the state for its centennial. Walk room to room through the doorways."
    },
    {
      "id": "habitats",
      "title": "Marsh to surf",
      "short": "Marsh to surf",
      "at": [420, 560],
      "icon": "ossabaw-art/icons--habitats.5e304fd99c.webp",
      "intro": "Walk west to east from the salt marsh to the surf. Tap an animal to add it to your field journal, and slide the tide to flood the marsh."
    },
    {
      "id": "hogs",
      "title": "The Ossabaw hogs",
      "short": "The hogs",
      "at": [640, 960],
      "icon": "ossabaw-art/icons--hogs.f20d7cad9d.webp",
      "intro": "Hogs descended from Spanish stock root for acorns under the live oaks. Adults weigh 100 lb to 200 lb."
    },
    {
      "id": "donkeys",
      "title": "The free-range donkeys",
      "short": "The donkeys",
      "at": [888, 560],
      "icon": "ossabaw-art/icons--donkeys.3fecc5083d.webp",
      "intro": "8 donkeys still roam the old fields, the last of the herd Sandy West started in 1965."
    },
    {
      "id": "turtles",
      "title": "The nesting beach",
      "short": "Nesting beach",
      "at": [936, 770],
      "icon": "ossabaw-art/icons--turtles.67953f45d2.webp",
      "intro": "Step through one loggerhead nest, from the night it is dug to the night the hatchlings run for the sea."
    },
    {
      "id": "journal",
      "title": "Your field journal",
      "short": "Field journal",
      "at": [1400, 1000],
      "icon": "ossabaw-art/icons--journal.e375742909.webp",
      "intro": "Stamps mark the stops you have visited, and the list shows the animals you have spotted. Tap a stamp to go back."
    }
  ],
  "pins": [
    {
      "title": "Middle Place",
      "at": [600, 452],
      "text": "2 miles down the Main Road: a Guale village, a cotton plantation, a freedpeople's church and, from 1970, the Genesis Project."
    },
    {
      "title": "Freshwater ponds",
      "at": [705, 692],
      "text": "In 1924 artesian wells fed 15 ponds. The wells stopped in the 1960s, and the ponds now fill with rain."
    },
    {
      "title": "Bradley Point",
      "at": [1165, 250],
      "text": "Dunes here rise about 30 feet over Ossabaw Sound."
    },
    {
      "title": "Hunt Camp",
      "at": [425, 735],
      "text": "Georgia DNR's check-in station and dock on Newell Creek, where hunters land for the deer and hog hunts."
    },
    {
      "title": "South End",
      "at": [530, 1112],
      "text": "The sea has cut into the forest here and left a bone yard of dead oaks and pines on the beach."
    }
